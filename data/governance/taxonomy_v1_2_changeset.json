    },
    {
      "term": "数据服务",
      "l3_code": "T4.01.04",
      "reason": "泛 IT 服务词错挂数据集；无对应窄词形，直接下线"
    },
    {
      "term": "训练场",
      "l3_code": "T4.01.02",
      "reason": "歧义词；改由『机器人训练场/具身训练场/数字训练场』承接"
    },
    {
      "term": "ACT",
      "l3_code": "T1.01.11",
