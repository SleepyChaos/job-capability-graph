{
  "base_version": "v1.1",
  "target_version": "v1.2",
  "effective_date": "2026-08-18",
  "change_summary": "窗口 C 词表治理：下线过宽词、按词形收窄歧义词、补齐部署推理/实时通信/仿真栈/电机控制等工程实践类覆盖盲区。",
  "provenance": {
    "retire_terms": "docs/reports/过宽表面词排查报告.md 第 3 节判定清单",
    "new_l3": "docs/reports/L3覆盖盲区排查报告.md 第 2 节候选清单 + annotator_C 标注的 MISSING 条目",
    "new_terms": "同上；词形面向招聘语料（短词/英文缩写/在售称谓），学术长术语不再新增"
  },
  "scope_exclusions": [
    {
      "item": "电池系统/BMS/热管理/结构设计",
      "reason": "通用机电工程，非具身智能技术点；L3覆盖盲区报告已标为『范围争议项』"
    },
    {
      "item": "PCB/原理图/EMC/RTL/ISP/HALT",
      "reason": "通用硬件工程实践，超出具身智能技术口径（任务书第 2 节边界 1）"
    },
    {
      "item": "CVPR/ICRA/NeurIPS 等会议词",
      "reason": "资质信号而非技术点，L3覆盖盲区报告建议不收"
    },
    {
      "item": "整机在售型号词（宇树 G1/H1 等）",
      "reason": "型号追踪不是本研究目标，且型号迭代快会造成词表快速过期"
    },
    {
      "item": "robot/robotics 等英文整机泛称",
      "reason": "触发面过宽，等价于不做区分"
    }
  ],
  "retire_terms": [
    {
      "term": "大模型",
      "l3_code": "T1.01.11",
      "reason": "≠VLA；LLM 复核对同词接受率 0.4%，语境规则仍放行 168 条误报"
    },
    {
      "term": "商业服务",
      "l3_code": "T7.03.03",
      "reason": "business services ≠ 商用服务机器人；命中全为销售/业务拓展岗"
    },
    {
      "term": "职业教育",
      "l3_code": "T7.07.03",
      "reason": "泛教育行业词 ≠ 教育机器人；命中为渠道销售/课程教研"
    },
    {
      "term": "AI教育",
      "l3_code": "T7.07.03",
      "reason": "同『职业教育』"
    },
    {
      "term": "开源框架",
