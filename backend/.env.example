APP_ENV=development
APP_DATABASE_URL=sqlite+pysqlite:///./.local/dev.db
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1

# LLM 网关（OpenAI 兼容，默认 DeepSeek）：无 Key 时全部调用降级为规则输出
APP_LLM_API_KEY=
APP_LLM_BASE_URL=https://api.deepseek.com/v1
APP_LLM_MODEL=deepseek-chat
APP_LLM_TIMEOUT_SECONDS=30

# 也兼容旧变量名 OPENAI_API_KEY、OPENAI_BASE_URL、LLM_MODEL。

# 认证（D5）：生产部署必须改为随机密钥
APP_AUTH_SECRET=

# 生产/联调环境示例（不要在仓库中填写真实口令）
# APP_DATABASE_URL=mysql+pymysql://app:password@mysql:3306/job_capability_graph?charset=utf8mb4
