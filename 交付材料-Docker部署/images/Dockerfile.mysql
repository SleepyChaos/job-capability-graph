# 交付用 MySQL 镜像：把已审计的运行数据烘进镜像，首启自动导入。
#
# 仓库里的 compose 靠 restore→migrate→bootstrap 三个服务建库，它们要挂 ./data 下的
# 快照与核心 XLSX——那是源码树里的东西。交付镜像包不能依赖源码目录，因此改成把
# 完整运行库（含 Alembic head 结构与全部业务数据）直接放进镜像。
#
# 不用 `docker commit` 一个跑过的容器：mysql:8.0 对 /var/lib/mysql 声明了 VOLUME，
# 该路径下的内容不会被 commit 进镜像，提交出来的是个空库。走 initdb.d 才可靠。
FROM mysql:8.0

# 与仓库 docker-compose.yml 一致的开发口令。交付评审用途；对外部署必须改。
ENV MYSQL_ROOT_PASSWORD=root_password_change_me \
    MYSQL_DATABASE=job_capability_graph \
    MYSQL_USER=app \
    MYSQL_PASSWORD=app_password_change_me

# 官方 entrypoint 在数据目录为空时按文件名顺序执行 initdb.d 下的 .sql/.sql.gz/.sh。
# 首次 `up` 会在这里花几分钟导入；之后数据落在卷里，重启即时可用。
COPY job_capability_graph.sql.gz /docker-entrypoint-initdb.d/01-job_capability_graph.sql.gz

CMD ["--character-set-server=utf8mb4", "--collation-server=utf8mb4_unicode_ci"]
